{:description "Gogs is a painless self-hosted Git service",
 :source {:github "gogs/gogs"}
 :checksum "https://dl.gogs.io/{version}/checksum_sha256.txt"
 :bins {"gogs" "gogs/gogs"}
 :platforms {"linux-x86_64" {:asset "gogs_{tag}_linux_amd64.tar.gz"}
             "linux-aarch64" {:asset "gogs_{tag}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "gogs_{tag}_darwin_amd64.zip"}
             "darwin-aarch64" {:asset "gogs_{tag}_darwin_arm64.zip"}}}
