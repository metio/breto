{:description "Builds ripgrep on Azure Pipelines for multiple platforms and makes the binaries available as Github releases",
 :source {:github "microsoft/ripgrep-prebuilt"}
 :bins {"rg" "rg"}
 :platforms {"linux-x86_64" {:asset "ripgrep-{tag}-x86_64-unknown-linux-musl.tar.gz"}
             "linux-aarch64" {:asset "ripgrep-{tag}-aarch64-unknown-linux-musl.tar.gz"}
             "darwin-x86_64" {:asset "ripgrep-{tag}-x86_64-apple-darwin.tar.gz"}
             "darwin-aarch64" {:asset "ripgrep-{tag}-aarch64-apple-darwin.tar.gz"}}}
