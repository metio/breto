{:description "Eclipse's language server for Java, which needs Java 25 or newer and python3"
 :source {:text "https://download.eclipse.org/jdtls/milestones/" :match "milestones/(\\d+\\.\\d+\\.\\d+)" :newest true}
 :tag-prefix ""
 :vars {:build {:text "https://download.eclipse.org/jdtls/milestones/{version}/latest.txt"
                :match "jdt-language-server-[^-]+-(\\d+)\\.tar\\.gz"}}
 :url "https://download.eclipse.org/jdtls/milestones/{version}/{asset}"
 :checksum "{asset}.sha256"
 :layout :tree
 :bins {"jdtls" "bin/jdtls"}
 :platforms {"linux-x86_64" {:asset "jdt-language-server-{version}-{build}.tar.gz"}}}
