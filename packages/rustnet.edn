             "darwin-x86_64" {:asset "rustnet-{tag}-x86_64-apple-darwin.tar.gz" :bins {"rustnet" "rustnet-{tag}-x86_64-apple-darwin/rustnet"}}
             "darwin-aarch64" {:asset "rustnet-{tag}-aarch64-apple-darwin.tar.gz" :bins {"rustnet" "rustnet-{tag}-aarch64-apple-darwin/rustnet"}}}}
