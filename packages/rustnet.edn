 :source {:github "domcyrus/rustnet"}
 :platforms {"linux-x86_64" {:asset "rustnet-{tag}-x86_64-unknown-linux-musl.tar.gz" :bins {"rustnet" "rustnet-{tag}-x86_64-unknown-linux-musl/rustnet"}}
