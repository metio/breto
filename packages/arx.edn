{:description "Store files and directory in an archive. Like tar, but faster and with direct random access",
 :source {:github "jubako/arx"}
 :tag-prefix ""
 :checksum "{asset}.sha256"
 :platforms {"linux-x86_64" {:asset "arx-{tag}-linux.tar.gz" :bins {"arx" "arx-{tag}-linux/arx"}}
             "darwin-x86_64" {:asset "arx-{tag}-macos.tar.gz" :bins {"arx" "arx-{tag}-macos/arx"}}}}
