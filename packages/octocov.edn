{:description "octocov is a toolkit for collecting code metrics (code coverage, code to test ratio, test execution time and your own custom metrics)",
 :source {:github "k1LoW/octocov"}
 :platforms {"linux-x86_64" {:asset "octocov_{tag}_linux_amd64.tar.gz" :checksum "checksums-linux.txt"}
             "linux-aarch64" {:asset "octocov_{tag}_linux_arm64.tar.gz" :checksum "checksums-linux.txt"}
             "darwin-x86_64" {:asset "octocov_{tag}_darwin_amd64.zip" :checksum "checksums-darwin.txt"}
             "darwin-aarch64" {:asset "octocov_{tag}_darwin_arm64.zip" :checksum "checksums-darwin.txt"}}}
