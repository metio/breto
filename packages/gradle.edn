{:description "The Gradle build tool, which runs on the java found through JAVA_HOME or PATH"
 :source {:json "https://services.gradle.org/versions/current" :version ["version"]}
 :tag-prefix ""
 :url "https://services.gradle.org/distributions/{asset}"
 :checksum "{asset}.sha256"
 :strip 1
 :layout :tree
 :bins {"gradle" "bin/gradle"}
 :platforms {"linux-x86_64" {:asset "gradle-{version}-bin.zip"}}}
