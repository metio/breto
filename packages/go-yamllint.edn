{:description "A distribution of yamllint that can be used with go run",
 :source {:github "wasilibs/go-yamllint"}
 :checksum "checksums.txt"
 :bins {"yamllint" "yamllint"}
 :platforms {"linux-x86_64" {:asset "go-yamllint_{version}_linux_amd64.tar.gz"}
             "linux-aarch64" {:asset "go-yamllint_{version}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "go-yamllint_{version}_darwin_amd64.tar.gz"}
             "darwin-aarch64" {:asset "go-yamllint_{version}_darwin_arm64.tar.gz"}}}
