{:description "A shell parser, formatter, and interpreter with bash and zsh support; includes shfmt",
 :source {:github "mvdan/sh"}
 :bins {"shfmt" "{asset}"}
 :platforms {"linux-x86_64" {:asset "shfmt_{tag}_linux_amd64"}
             "linux-aarch64" {:asset "shfmt_{tag}_linux_arm64"}
             "darwin-x86_64" {:asset "shfmt_{tag}_darwin_amd64"}
             "darwin-aarch64" {:asset "shfmt_{tag}_darwin_arm64"}}}
