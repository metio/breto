{:description "An efficient JSON to YAML converter written in Go language",
 :source {:github "itchyny/json2yaml"}
 :platforms {"linux-x86_64" {:asset "json2yaml_{tag}_linux_amd64.tar.gz" :bins {"json2yaml" "json2yaml_{tag}_linux_amd64/json2yaml"}}
             "linux-aarch64" {:asset "json2yaml_{tag}_linux_arm64.tar.gz" :bins {"json2yaml" "json2yaml_{tag}_linux_arm64/json2yaml"}}
             "darwin-x86_64" {:asset "json2yaml_{tag}_darwin_amd64.zip" :bins {"json2yaml" "json2yaml_{tag}_darwin_amd64/json2yaml"}}
             "darwin-aarch64" {:asset "json2yaml_{tag}_darwin_arm64.zip" :bins {"json2yaml" "json2yaml_{tag}_darwin_arm64/json2yaml"}}}}
