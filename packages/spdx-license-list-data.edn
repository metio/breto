{:description "The SPDX license list in every format the SPDX project publishes; SPDX_LICENSE_LIST_DATA points at the directory holding json/licenses.json"
 :source {:github "spdx/license-list-data"}
 :url "https://github.com/spdx/license-list-data/archive/refs/tags/{tag}.tar.gz"
 :asset "license-list-data-{version}.tar.gz"
 :verify false
 :strip 1
 :layout :tree
 :bins {}
 :env {"SPDX_LICENSE_LIST_DATA" "{home}"}
 :platforms {"linux-x86_64" {} "linux-aarch64" {} "darwin-x86_64" {} "darwin-aarch64" {}}}
