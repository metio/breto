{:description "Create book from markdown files. Like Gitbook but implemented in Rust",
 :source {:github "rust-lang/mdBook"}
 :platforms {"linux-x86_64" {:asset "mdbook-{tag}-x86_64-unknown-linux-musl.tar.gz"}
             "linux-aarch64" {:asset "mdbook-{tag}-aarch64-unknown-linux-musl.tar.gz"}
             "darwin-x86_64" {:asset "mdbook-{tag}-x86_64-apple-darwin.tar.gz"}
             "darwin-aarch64" {:asset "mdbook-{tag}-aarch64-apple-darwin.tar.gz"}}}
