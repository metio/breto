{:description "The Rust toolchain installer, whose proxies run the toolchain a rust-toolchain.toml or rustup default selects"
 :source {:text "https://static.rust-lang.org/rustup/release-stable.toml"
          :match "(?m)^version = '([^']+)'"}
 :tag-prefix ""
 :checksum "{asset}.sha256"
 :bins {"rustup" "rustup-init"
        "rustc" "rustup-init"
        "rustdoc" "rustup-init"
        "cargo" "rustup-init"
        "rust-lldb" "rustup-init"
        "rust-gdb" "rustup-init"
        "rust-gdbgui" "rustup-init"
        "cargo-clippy" "rustup-init"
        "clippy-driver" "rustup-init"
        "cargo-miri" "rustup-init"
        "rust-analyzer" "rustup-init"
        "rustfmt" "rustup-init"
        "cargo-fmt" "rustup-init"}
 :asset "rustup-init"
 :platforms {"linux-x86_64" {:url "https://static.rust-lang.org/rustup/archive/{version}/x86_64-unknown-linux-gnu/{asset}"}
             "linux-aarch64" {:url "https://static.rust-lang.org/rustup/archive/{version}/aarch64-unknown-linux-gnu/{asset}"}
             "darwin-x86_64" {:url "https://static.rust-lang.org/rustup/archive/{version}/x86_64-apple-darwin/{asset}"}
             "darwin-aarch64" {:url "https://static.rust-lang.org/rustup/archive/{version}/aarch64-apple-darwin/{asset}"}}}
