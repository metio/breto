{:description "The Julia programming language"
 :source {:github "JuliaLang/julia"}
 :vars {:minor {:match "^\\d+\\.\\d+"}}
 :checksum "https://julialang-s3.julialang.org/bin/checksums/julia-{version}.sha256"
 :strip 1
 :layout :tree
 :bins {"julia" "bin/julia"}
 :man ["share/man/man1/julia.1"]
 :platforms {"linux-x86_64" {:asset "julia-{version}-linux-x86_64.tar.gz" :url "https://julialang-s3.julialang.org/bin/linux/x64/{minor}/{asset}"}}}
