{:description "Node.js, the JavaScript runtime, with npm and npx, in its current release"
 :source {:text "https://nodejs.org/dist/latest/SHASUMS256.txt" :match "node-(v\\d+\\.\\d+\\.\\d+)-linux-x64\\.tar\\.xz"}
 :asset "node-v{version}-linux-x64.tar.xz"
 :url "https://nodejs.org/dist/{tag}/{asset}"
 :checksum "https://nodejs.org/dist/{tag}/SHASUMS256.txt"
 :strip 1
 :layout :tree
 :bin-dir "bin"
 :man ["share/man/man1/node.1"]
 :platforms {"darwin-aarch64" {:asset "node-v{version}-darwin-arm64.tar.xz"}
             "darwin-x86_64" {:asset "node-v{version}-darwin-x64.tar.xz"}
             "linux-aarch64" {:asset "node-v{version}-linux-arm64.tar.xz"}}}
