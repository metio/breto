{:description "A helm plugin that unit tests the templates of a chart, found by helm through HELM_PLUGINS in a project that uses it"
 :source {:github "helm-unittest/helm-unittest"}
 :layout :tree
 :bins {}
 :env {"HELM_PLUGINS" "{homes}"}
 :platforms {"darwin-aarch64" {:asset "helm-unittest-macos-arm64-{version}.tgz"}
             "darwin-x86_64" {:asset "helm-unittest-macos-amd64-{version}.tgz"}
             "linux-aarch64" {:asset "helm-unittest-linux-arm64-{version}.tgz"}
             "linux-x86_64" {:asset "helm-unittest-linux-amd64-{version}.tgz"}}}
