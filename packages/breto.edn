{:description "Declarative installs of prebuilt binaries, as one executable with the package definitions of its release built in"
 :source {:github "metio/breto"}
 :tag-prefix ""
 :checksum "breto_{version}_SHA256SUMS"
 :bins {"breto" "{asset}"}
 :signature {:bundle "breto_{version}_SHA256SUMS.bundle"
             :identity "https://github.com/metio/breto/.github/workflows/release.yml@refs/heads/main"
             :issuer "https://token.actions.githubusercontent.com"
             :of :checksum}
 :platforms {"darwin-aarch64" {:asset "breto-darwin-aarch64"}
             "darwin-x86_64" {:asset "breto-darwin-amd64"}
             "linux-aarch64" {:asset "breto-linux-aarch64"}
             "linux-x86_64" {:asset "breto-linux-amd64"}}}
