{:description "Oracle GraalVM, a JDK with the native-image compiler, in the newest feature release Oracle publishes for download"
 :source {:text "https://api.foojay.io/disco/v3.0/packages?distribution=graalvm&latest=available&operating_system=linux&architecture=x64&archive_type=tar.gz&package_type=jdk&release_status=ga"
          :match "\"filename\":\"graalvm-jdk-(\\d+\\.\\d+\\.\\d+)_linux-x64_bin\\.tar\\.gz\""}
 :tag-prefix ""
 :vars {:feature {:match "^(\\d+)"}}
 :url "https://download.oracle.com/graalvm/{feature}/archive/{asset}"
 :checksum "{asset}.sha256"
 :strip 1
 :layout :tree
 :bin-dir "bin"
 :env {"JAVA_HOME" "{home}" "GRAALVM_HOME" "{home}"}
 :platforms {"linux-x86_64" {:asset "graalvm-jdk-{version}_linux-x64_bin.tar.gz"}}}
