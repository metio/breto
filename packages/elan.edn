{:description "The Lean toolchain manager, whose proxies run the Lean version a lean-toolchain file or elan default selects"
 :source {:github "leanprover/elan"}
 :bins {"elan" "elan-init"
        "lean" "elan-init"
        "lake" "elan-init"
        "leanc" "elan-init"
        "leanmake" "elan-init"
        "leanpkg" "elan-init"
        "leanchecker" "elan-init"}
 :platforms {"linux-x86_64" {:asset "elan-x86_64-unknown-linux-gnu.tar.gz"}
             "linux-aarch64" {:asset "elan-aarch64-unknown-linux-gnu.tar.gz"}
             "darwin-x86_64" {:asset "elan-x86_64-apple-darwin.tar.gz"}
             "darwin-aarch64" {:asset "elan-aarch64-apple-darwin.tar.gz"}}}
