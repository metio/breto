{:description "Oracle GraalVM for JDK 21, a JDK with the native-image compiler, in the newest update of the 21 long-term support release"
 :source {:text "https://api.foojay.io/disco/v3.0/packages?distribution=graalvm&latest=available&operating_system=linux&architecture=x64&archive_type=tar.gz&package_type=jdk&release_status=ga&version=21"
          :match "\"filename\":\"graalvm-jdk-(21\\.\\d+\\.\\d+)_linux-x64_bin\\.tar\\.gz\""}
 :tag-prefix ""
 :url "https://download.oracle.com/graalvm/21/archive/{asset}"
 :checksum "{asset}.sha256"
 :strip 1
 :layout :tree
 :bin-dir "bin"
 :env {"JAVA_HOME" "{install-dir}" "GRAALVM_HOME" "{install-dir}"}
 :platforms {"linux-x86_64" {:asset "graalvm-jdk-{version}_linux-x64_bin.tar.gz"}
             "linux-aarch64" {:asset "graalvm-jdk-{version}_linux-aarch64_bin.tar.gz"}
             "darwin-aarch64" {:asset "graalvm-jdk-{version}_macos-aarch64_bin.tar.gz" :bin-dir "Contents/Home/bin" :env {"JAVA_HOME" "{install-dir}/Contents/Home" "GRAALVM_HOME" "{install-dir}/Contents/Home"}}}}
