{:description "A community command-line client for the Bronto observability platform. It wraps Bronto's REST and ingestion APIs in a single scriptable binary: search and tail logs, explore OpenTelemetry traces, send events, and manage resources (datasets, monitors, dashboards, parsers, exports, API keys)",
 :source {:github "bronto-community/bronto-cli"}
 :checksum "checksums.txt"
 :bins {"bronto" "bronto"}
 :platforms {"linux-x86_64" {:asset "bronto_{version}_linux_amd64.tar.gz"}
             "linux-aarch64" {:asset "bronto_{version}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "bronto_{version}_darwin_amd64.tar.gz"}
             "darwin-aarch64" {:asset "bronto_{version}_darwin_arm64.tar.gz"}}}
