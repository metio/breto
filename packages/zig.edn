{:description "The Zig programming language and its C and C++ compiler"
 :source {:text "https://ziglang.org/download/index.json" :match "\"(\\d+\\.\\d+\\.\\d+)\":\\s*\\{"}
 :tag-prefix ""
 :url "https://ziglang.org/download/{version}/{asset}"
 :strip 1
 :layout :tree
 :bins {"zig" "zig"}
 :platforms {"linux-x86_64" {:asset "zig-x86_64-linux-{version}.tar.xz"
                             :checksum {:json "https://ziglang.org/download/index.json" :hash ["{version}" "x86_64-linux" "shasum"]}
                             :history [{:before "0.14.1" :asset "zig-linux-x86_64-{version}.tar.xz"}]}
             "linux-aarch64" {:asset "zig-aarch64-linux-{version}.tar.xz" :checksum {:json "https://ziglang.org/download/index.json" :hash ["{version}" "aarch64-linux" "shasum"]} :history [{:before "0.14.1" :asset "zig-linux-aarch64-{version}.tar.xz"}]}
             "darwin-x86_64" {:asset "zig-x86_64-macos-{version}.tar.xz" :checksum {:json "https://ziglang.org/download/index.json" :hash ["{version}" "x86_64-macos" "shasum"]} :history [{:before "0.14.1" :asset "zig-macos-x86_64-{version}.tar.xz"}]}
             "darwin-aarch64" {:asset "zig-aarch64-macos-{version}.tar.xz" :checksum {:json "https://ziglang.org/download/index.json" :hash ["{version}" "aarch64-macos" "shasum"]} :history [{:before "0.14.1" :asset "zig-macos-aarch64-{version}.tar.xz"}]}}}
