{:description "Command line client for Testkube, which runs tests inside Kubernetes"
 :source {:github "kubeshop/testkube"}
 :tag-prefix ""
 :checksum "checksums.txt"
 :bins {"testkube" "kubectl-testkube" "kubectl-testkube" "kubectl-testkube"}
 :signature {:of :checksum
             :bundle "checksums.txt.sigstore.json"
             :identity "https://github.com/kubeshop/testkube/.github/workflows/release.yaml@refs/tags/{tag}"
             :issuer "https://token.actions.githubusercontent.com"}
 :platforms {"linux-x86_64" {:asset "testkube_{version}_Linux_x86_64.tar.gz"}
             "linux-aarch64" {:asset "testkube_{version}_Linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "testkube_{version}_Darwin_x86_64.tar.gz"}
             "darwin-aarch64" {:asset "testkube_{version}_Darwin_arm64.tar.gz"}}}
