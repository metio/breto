{:description "Retrieve semvers from git tags",
 :source {:github "Songmu/gitsemvers"}
 :platforms {"linux-x86_64" {:asset "gitsemvers_{tag}_linux_amd64.tar.gz" :bins {"git-semvers" "gitsemvers_{tag}_linux_amd64/git-semvers"}}
             "linux-aarch64" {:asset "gitsemvers_{tag}_linux_arm64.tar.gz" :bins {"git-semvers" "gitsemvers_{tag}_linux_arm64/git-semvers"}}
             "darwin-x86_64" {:asset "gitsemvers_{tag}_darwin_amd64.zip" :bins {"git-semvers" "gitsemvers_{tag}_darwin_amd64/git-semvers"}}
             "darwin-aarch64" {:asset "gitsemvers_{tag}_darwin_arm64.zip" :bins {"git-semvers" "gitsemvers_{tag}_darwin_arm64/git-semvers"}}}}
