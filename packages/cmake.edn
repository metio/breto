{:description "Mirror of CMake upstream repository",
 :source {:github "Kitware/CMake"}
 :platforms {"linux-x86_64" {:asset "cmake-{version}-linux-x86_64.tar.gz" :bins {"ccmake" "cmake-{version}-linux-x86_64/bin/ccmake", "cmake" "cmake-{version}-linux-x86_64/bin/cmake", "cmake-gui" "cmake-{version}-linux-x86_64/bin/cmake-gui", "cpack" "cmake-{version}-linux-x86_64/bin/cpack", "ctest" "cmake-{version}-linux-x86_64/bin/ctest"}}
             "linux-aarch64" {:asset "cmake-{version}-linux-aarch64.tar.gz" :bins {"ccmake" "cmake-{version}-linux-aarch64/bin/ccmake" "cmake" "cmake-{version}-linux-aarch64/bin/cmake" "cmake-gui" "cmake-{version}-linux-aarch64/bin/cmake-gui" "cpack" "cmake-{version}-linux-aarch64/bin/cpack" "ctest" "cmake-{version}-linux-aarch64/bin/ctest"}}
             "darwin-x86_64" {:asset "cmake-{version}-macos-universal.tar.gz" :bins {"ccmake" "cmake-{version}-macos-universal/bin/ccmake" "cmake" "cmake-{version}-macos-universal/bin/cmake" "cmake-gui" "cmake-{version}-macos-universal/bin/cmake-gui" "cpack" "cmake-{version}-macos-universal/bin/cpack" "ctest" "cmake-{version}-macos-universal/bin/ctest"}}
             "darwin-aarch64" {:asset "cmake-{version}-macos-universal.tar.gz" :bins {"ccmake" "cmake-{version}-macos-universal/bin/ccmake" "cmake" "cmake-{version}-macos-universal/bin/cmake" "cmake-gui" "cmake-{version}-macos-universal/bin/cmake-gui" "cpack" "cmake-{version}-macos-universal/bin/cpack" "ctest" "cmake-{version}-macos-universal/bin/ctest"}}}}
