{:description "The bosh CLI is the command line tool used for interacting with all things BOSH, from deployment operations to software release management",
 :source {:github "cloudfoundry/bosh-cli"}
 :bins {"bosh" "{asset}"}
 :platforms {"linux-x86_64" {:asset "bosh-cli-{version}-linux-amd64"}
             "linux-aarch64" {:asset "bosh-cli-{version}-linux-arm64"}
             "darwin-x86_64" {:asset "bosh-cli-{version}-darwin-amd64"}
             "darwin-aarch64" {:asset "bosh-cli-{version}-darwin-arm64"}}}
