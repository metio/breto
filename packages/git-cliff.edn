{:description "A highly customizable Changelog Generator that follows Conventional Commit specifications",
 :source {:github "orhun/git-cliff"}
 :checksum "{asset}.sha512"
 :bins {"git-cliff" "git-cliff-{version}/git-cliff"}
 :platforms {"linux-x86_64" {:asset "git-cliff-{version}-x86_64-unknown-linux-musl.tar.gz"}
             "linux-aarch64" {:asset "git-cliff-{version}-aarch64-unknown-linux-musl.tar.gz"}
             "darwin-x86_64" {:asset "git-cliff-{version}-x86_64-apple-darwin.tar.gz"}
             "darwin-aarch64" {:asset "git-cliff-{version}-aarch64-apple-darwin.tar.gz"}}}
