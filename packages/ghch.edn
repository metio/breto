{:description "Generate changelog from git history, tags and merged pull requests",
 :source {:github "Songmu/ghch"}
 :platforms {"linux-x86_64" {:asset "ghch_{tag}_linux_amd64.tar.gz" :bins {"ghch" "ghch_{tag}_linux_amd64/ghch"}}
             "linux-aarch64" {:asset "ghch_{tag}_linux_arm64.tar.gz" :bins {"ghch" "ghch_{tag}_linux_arm64/ghch"}}
             "darwin-x86_64" {:asset "ghch_{tag}_darwin_amd64.zip" :bins {"ghch" "ghch_{tag}_darwin_amd64/ghch"}}
             "darwin-aarch64" {:asset "ghch_{tag}_darwin_arm64.zip" :bins {"ghch" "ghch_{tag}_darwin_arm64/ghch"}}}}
