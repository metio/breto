{:description "Easily install prebuilt binaries from GitHub",
 :source {:github "zyedidia/eget"}
 :platforms {"linux-x86_64" {:asset "eget-{version}-linux_amd64.tar.gz" :bins {"eget" "eget-{version}-linux_amd64/eget"}}
             "linux-aarch64" {:asset "eget-{version}-linux_arm64.tar.gz" :bins {"eget" "eget-{version}-linux_arm64/eget"}}
             "darwin-x86_64" {:asset "eget-{version}-darwin_amd64.tar.gz" :bins {"eget" "eget-{version}-darwin_amd64/eget"}}
             "darwin-aarch64" {:asset "eget-{version}-darwin_arm64.tar.gz" :bins {"eget" "eget-{version}-darwin_arm64/eget"}}}}
