{:description "The etcd, kube-apiserver and kubectl binaries controller-runtime's envtest starts"
 :source {:github "kubernetes-sigs/controller-tools"}
 :tag-prefix "envtest-v"
 :layout :tree
 :bins {}
 :env {"KUBEBUILDER_ASSETS" "{install-dir}/controller-tools/envtest"}
 :platforms {"linux-x86_64" {:asset "envtest-v{version}-linux-amd64.tar.gz"}
             "linux-aarch64" {:asset "envtest-v{version}-linux-arm64.tar.gz"}
             "darwin-x86_64" {:asset "envtest-v{version}-darwin-amd64.tar.gz"}
             "darwin-aarch64" {:asset "envtest-v{version}-darwin-arm64.tar.gz"}}}
