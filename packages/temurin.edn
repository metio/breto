{:description "Eclipse Temurin OpenJDK, the newest generally available feature release"
 :source {:json "https://api.adoptium.net/v3/info/release_names?release_type=ga&sort_order=DESC&page_size=1&os=linux&architecture=x64&image_type=jdk&vendor=eclipse"
          :version [:releases 0]}
 :tag-prefix "jdk-"
 :vars {:feature {:match "^(\\d+)"} :file-version {:replace ["+" "_"]}}
 :url "https://github.com/adoptium/temurin{feature}-binaries/releases/download/{tag}/{asset}"
 :checksum "{asset}.sha256.txt"
 :strip 1
 :layout :tree
 :bin-dir "bin"
 :env {"JAVA_HOME" "{install-dir}"}
 :platforms {"linux-x86_64" {:asset "OpenJDK{feature}U-jdk_x64_linux_hotspot_{file-version}.tar.gz"}
             "linux-aarch64" {:asset "OpenJDK{feature}U-jdk_aarch64_linux_hotspot_{file-version}.tar.gz"}
             "darwin-aarch64" {:asset "OpenJDK{feature}U-jdk_aarch64_mac_hotspot_{file-version}.tar.gz" :bin-dir "Contents/Home/bin" :env {"JAVA_HOME" "{install-dir}/Contents/Home"}}}}
