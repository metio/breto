{:description "shippable application packaging",
 :source {:github "axodotdev/cargo-dist"}
 :checksum "{asset}.sha256"
 :platforms {"linux-x86_64" {:asset "cargo-dist-x86_64-unknown-linux-musl.tar.xz" :bins {"dist" "cargo-dist-x86_64-unknown-linux-musl/dist"}}
             "linux-aarch64" {:asset "cargo-dist-aarch64-unknown-linux-musl.tar.xz" :bins {"dist" "cargo-dist-aarch64-unknown-linux-musl/dist"}}
             "darwin-x86_64" {:asset "cargo-dist-x86_64-apple-darwin.tar.xz" :bins {"dist" "cargo-dist-x86_64-apple-darwin/dist"}}
             "darwin-aarch64" {:asset "cargo-dist-aarch64-apple-darwin.tar.xz" :bins {"dist" "cargo-dist-aarch64-apple-darwin/dist"}}}}
