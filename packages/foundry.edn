{:description "Foundry is a blazing fast, portable and modular toolkit for Ethereum application development written in Rust",
 :source {:github "foundry-rs/foundry"}
 :bins {"anvil" "anvil", "cast" "cast", "chisel" "chisel", "forge" "forge"}
 :platforms {"linux-x86_64" {:asset "foundry_{tag}_linux_amd64.tar.gz"}
             "linux-aarch64" {:asset "foundry_{tag}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "foundry_{tag}_darwin_amd64.tar.gz"}
             "darwin-aarch64" {:asset "foundry_{tag}_darwin_arm64.tar.gz"}}}
