{:description "CLI tool for linting and testing Helm charts, with the chart schema and yamllint config it reads through CT_CONFIG_DIR"
 :source {:github "helm/chart-testing"}
 :checksum "checksums.txt"
 :layout :tree
 :bins {"ct" "ct"}
 :env {"CT_CONFIG_DIR" "{install-dir}/etc"}
 :platforms {"linux-x86_64" {:asset "chart-testing_{version}_linux_amd64.tar.gz"}
             "linux-aarch64" {:asset "chart-testing_{version}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "chart-testing_{version}_darwin_amd64.tar.gz"}
             "darwin-aarch64" {:asset "chart-testing_{version}_darwin_arm64.tar.gz"}}}
