 :platforms {"linux-x86_64" {:asset "age-{tag}-linux-amd64.tar.gz"}
             "linux-aarch64" {:asset "age-{tag}-linux-arm64.tar.gz"}
             "darwin-x86_64" {:asset "age-{tag}-darwin-amd64.tar.gz"}
             "darwin-aarch64" {:asset "age-{tag}-darwin-arm64.tar.gz"}}}
