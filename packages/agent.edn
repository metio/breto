{:description "The Buildkite Agent is an open-source toolkit written in Golang for securely running build jobs on any device or network",
 :source {:github "buildkite/agent"}
 :bins {"buildkite-agent" "buildkite-agent"}
 :platforms {"linux-x86_64" {:asset "buildkite-agent-linux-amd64-{version}.tar.gz"}
             "linux-aarch64" {:asset "buildkite-agent-linux-arm64-{version}.tar.gz"}
             "darwin-x86_64" {:asset "buildkite-agent-darwin-amd64-{version}.tar.gz"}
             "darwin-aarch64" {:asset "buildkite-agent-darwin-arm64-{version}.tar.gz"}}}
