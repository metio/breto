{:description "Eclipse Temurin OpenJDK 21, the newest update of the 21 long-term support release"
 :source {:github "adoptium/temurin21-binaries"}
 :tag-prefix "jdk-"
 :vars {:file-version {:replace ["+" "_"]}}
 :checksum "{asset}.sha256.txt"
 :strip 1
 :layout :tree
 :bin-dir "bin"
 :env {"JAVA_HOME" "{home}"}
 :platforms {"linux-x86_64" {:asset "OpenJDK21U-jdk_x64_linux_hotspot_{file-version}.tar.gz"}
             "linux-aarch64" {:asset "OpenJDK21U-jdk_aarch64_linux_hotspot_{file-version}.tar.gz"}
             "darwin-x86_64" {:asset "OpenJDK21U-jdk_x64_mac_hotspot_{file-version}.tar.gz"
                              :bin-dir "Contents/Home/bin" :env {"JAVA_HOME" "{home}/Contents/Home"}}
             "darwin-aarch64" {:asset "OpenJDK21U-jdk_aarch64_mac_hotspot_{file-version}.tar.gz"
                               :bin-dir "Contents/Home/bin" :env {"JAVA_HOME" "{home}/Contents/Home"}}}}
